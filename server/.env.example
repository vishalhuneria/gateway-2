NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/gateway
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
# Used only by `npm run seed`; never use these values as real credentials.
BOOTSTRAP_ADMIN_EMAIL=admin@iitrpr.ac.in
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
BOOTSTRAP_GUARD_EMAIL=guard@iitrpr.ac.in
BOOTSTRAP_GUARD_PASSWORD=replace-with-a-strong-guard-password
